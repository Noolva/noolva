# Copy to .env for local overrides (optional). Vite loads .env automatically; see vite.config.js / src/config/runtimeApi.js
#
# VITE_API_URL — API host only (no /api suffix). If unset/empty:
#   - JSON calls use relative /api (works with Vite dev proxy to the API).
#   - Asset URLs in dev still fall back to http://localhost:9001 when no runtime apiOrigin (see runtimeApi.js).
#
# VITE_APP_SCOPE — theme API scope (saas, tenant, …). Overridden by public/runtime-config.json "scope" if set.
#
# --- public/runtime-config.json (loaded at startup; copied to dist) ---
# Deployed (nginx sends same-host /api to your API):
#   { "apiOrigin": "", "scope": "saas" }
# Local (SPA calls API on host:port directly, e.g. bypass Vite proxy):
#   { "apiOrigin": "http://localhost:9001", "scope": "saas" }
# Local (prefer Vite proxy — same as prod pattern): keep apiOrigin "" and leave VITE_API_URL unset.

# VITE_API_URL=http://localhost:9001
VITE_APP_SCOPE=saas
