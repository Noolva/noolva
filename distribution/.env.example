# Sample .env for the deployed Noolva API binary.
# Copy this file to ".env" next to noolva.bin on the target host and fill in values.
# python-dotenv loads it automatically when you run:
#     venv/bin/python3 noolva.bin runserver

# --- Network ---
APPLICATION_PORT=9001
APPLICATION_HOST=0.0.0.0

# --- Logging ---
# Either a full file path (preferred):
LOG_PATH=/var/log/noolva/noolva.log
# Or a directory (legacy; ignored when LOG_PATH is set; default "logs"):
# LOG_DIR=logs

# Daily log rotation in UTC. Format HH:MM (24h). Default 18:30 UTC (= 00:00 IST).
LOG_ROTATE_TIME_UTC=18:30
# Keep this many rotated files. Default 14.
LOG_ROTATE_BACKUP_COUNT=14

# --- Database (PostgreSQL) ---
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# --- Auth / Sessions ---
# SESSION_SECRET=change-me

# --- Encryption (for data-model field values) ---
# ENCRYPTION_KEY=

# --- Display / Timezone (admin UI) ---
APP_TIMEZONE=Asia/Kolkata
APP_TIME_FORMAT=DD/MM/YYYY h:mm A

# --- Job Scheduler (optional) ---
# ENABLE_SCHEDULER=true
# SCHEDULER_INTERVAL=5
# SCHEDULER_FETCH_LIMIT=100
# WORKER_COUNT=2
# WORKER_CONCURRENCY=4
# QUEUE_MAX_SIZE=10000
# DEFAULT_JOB_TIMEOUT_SECONDS=300
# DEFAULT_JOB_MAX_RETRIES=3
# WORKER_MEMORY_LIMIT_MB=
# SERVER_MEMORY_LIMIT_MB=

# --- Custom query worker auth (only when jobs run on a remote worker) ---
# CUSTOM_QUERY_PAT=nvpat_...

# --- Frontend ---
# FRONTEND_URL=http://localhost:3000
